# Copy this template to .env. Replace each placeholder; never commit .env.
# NVIDIA Build cloud key for nvidia_follow.py --mode build. Not needed by the live edge dashboard.
NVIDIA_API_KEY=replace_me
NVIDIA_BODY_POSE_TARGET=grpc.nvcf.nvidia.com:443
NVIDIA_BODY_POSE_FUNCTION_ID=254b3621-bb66-4b7b-9c89-621c352b4d91

# Dashboard login. Generate a random password with 24+ characters.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=replace_with_random_secret_at_least_24_chars
EVENT_RETENTION_DAYS=30

# Public DNS name for Caddy HTTPS deployment. Point DNS at this host first.
CADDY_DOMAIN=cameras.example.com

# Needed only for the optional self-hosted NVIDIA NIM container on supported Linux GPU hosts.
NGC_API_KEY=replace_with_ngc_catalog_key
NIM_CONCURRENCY=1
